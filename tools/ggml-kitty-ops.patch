+    int32_t n_sink = 0, n_vp = 0, n_vqbuf = 0;
+    memcpy(&n_sink,  (const char *) dst->op_params + 0, 4);
+    memcpy(&n_vp,    (const char *) dst->op_params + 4, 4);
+    memcpy(&n_vqbuf, (const char *) dst->op_params + 8, 4);
+    vk_op_kitty_sv_push_constants pc {
+        (uint32_t) probs->ne[0], (uint32_t) n_sink, (uint32_t) n_vp, (uint32_t) n_vqbuf,
