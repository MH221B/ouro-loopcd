+    memcpy(&n_qbuf,  (const char *) dst->op_params + 4,  4);
+    memcpy(&n_pages, (const char *) dst->op_params + 8,  4);
+    memcpy(&scale,   (const char *) dst->op_params + 12, 4);
+    vk_op_kitty_qk_push_constants pc {
+        (uint32_t) dst->ne[0], (uint32_t) n_sink, (uint32_t) n_qbuf, (uint32_t) n_pages,
