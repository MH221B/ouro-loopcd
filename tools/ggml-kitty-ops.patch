diff --git a/src/ggml-vulkan/vulkan-shaders/kitty_qk.comp b/src/ggml-vulkan/vulkan-shaders/kitty_qk.comp
new file mode 100644
index 00000000..75d84ecf
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/kitty_qk.comp
@@ -0,0 +1,96 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_control_flow_attributes : enable
+
+layout (push_constant) uniform parameter {
+    uint  n_kv;
+    uint  n_sink;
+    uint  n_qbuf;
+    uint  n_pages;
+    uint  n_q;
+    uint  n_head;
+    uint  kf_row_stride;
+    float scale;
+} p;
+
+#include "types.glsl"
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer Q  { float     data_q[];  };
+layout(binding = 1) readonly  buffer KF { float16_t data_kf[]; };
+layout(binding = 2) readonly  buffer KP { uint      data_kp[]; };
+layout(binding = 3) writeonly buffer L  { float     data_l[];  };
+
+const uint D       = 128u;
+const uint P       = 128u;
+const uint D_BOOST = 32u;
+const uint K_OFF_HIGH = 4096u;
+const uint K_OFF_IDX  = 5120u;
+const uint K_OFF_META = 5248u;
+const uint K_HEAD     = 5760u;
+
+shared float q_sh[D];
+shared float part[16u * D];
+
+// Extract token i (0..15) of a 4-byte little-endian token group.
+uint tok2(uint u, uint i) { return (u >> (((i / 4u) * 8u) + ((i % 4u) * 2u))) & 3u; }
+
+void main() {
+    const uint block = gl_WorkGroupID.x;
+    const uint qi    = gl_WorkGroupID.y;
+    const uint h     = gl_WorkGroupID.z;
+    const uint d     = gl_LocalInvocationID.x;
+
+    const uint kf_stride = p.kf_row_stride;          // = n_embd_kv (elements per staging row)
+    q_sh[d] = data_q[(qi * p.n_head + h) * D + d];
+    barrier();
+
+    const uint key0 = block * 16u;
+    float acc[16];
+    [[unroll]] for (uint i = 0u; i < 16u; ++i) acc[i] = 0.0;
+
+    const bool in_page = (key0 >= p.n_sink) && (key0 + 16u <= p.n_sink + p.n_pages * P);
+    if (in_page) {
+        const uint prel = key0 - p.n_sink;
+        const uint t0   = prel % P;                  // multiple of 16
+        const uint hb   = h * K_HEAD;
+        const uint lowb = data_kp[(hb + d * (P / 4u) + t0 / 4u) / 4u];
+        const uint idxb = data_kp[(hb + K_OFF_IDX + (d & ~3u)) / 4u];
+        const uint idx  = (idxb >> ((d & 3u) * 8u)) & 0xffu;
+        vec2 sm = unpackHalf2x16(data_kp[(hb + K_OFF_META + d * 4u) / 4u]);
+        const float scale_d = sm.x, min_d = sm.y;
+        uint highb = 0u;
+        if (idx < D_BOOST) highb = data_kp[(hb + K_OFF_HIGH + idx * (P / 4u) + t0 / 4u) / 4u];
+        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
+            const uint lo = tok2(lowb, i);
+            const uint hi = (idx < D_BOOST) ? tok2(highb, i) : 0u;
+            const float val = float(lo | (hi << 2u)) * scale_d + min_d;
+            acc[i] = q_sh[d] * val;
+        }
+    } else {
+        // Non-page blocks are the sink and the qbuf region. The key axis is
+        // [sink | pages | qbuf], but the staging rows are [sink | qbuf] CONTIGUOUS,
+        // so a qbuf key maps to row = key - n_pages*P. (Using row == key zeroes the
+        // pending logits whenever n_pages > 0.)
+        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
+            const uint key = key0 + i;
+            if (key < p.n_kv) {
+                const uint row = (key < p.n_sink) ? key : (key - p.n_pages * P);
+                acc[i] = q_sh[d] * float(data_kf[h * D + d + row * kf_stride]);
+            }
+        }
+    }
+
+    [[unroll]] for (uint i = 0u; i < 16u; ++i) part[i * D + d] = acc[i];
+    barrier();
+
+    if (d < 16u) {
+        const uint key = key0 + d;
+        if (key < p.n_kv) {
+            float s = 0.0;
+            [[unroll]] for (uint j = 0u; j < D; ++j) s += part[d * D + j];
+            data_l[(h * p.n_q + qi) * p.n_kv + key] = s * p.scale;
+        }
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/kitty_sv.comp b/src/ggml-vulkan/vulkan-shaders/kitty_sv.comp
new file mode 100644
index 00000000..cbf6391f
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/kitty_sv.comp
@@ -0,0 +1,67 @@
+#version 450
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_control_flow_attributes : enable
+
+layout (push_constant) uniform parameter {
+    uint n_kv;
+    uint n_sink;
+    uint n_vp;
+    uint n_vqbuf;
+    uint n_head;
+    uint n_q;
+    uint vf_row_stride;
+    uint pad0;
+} p;
+
+#include "types.glsl"
+
+layout(local_size_x = 8, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly  buffer S  { float     data_s[];  };  // probs [n_kv, n_q, n_head]
+layout(binding = 1) readonly  buffer VF { float16_t data_vf[]; };  // staging [D, n_head, sink+P]
+layout(binding = 2) readonly  buffer VP { uint      data_vp[]; };  // packed V blob
+layout(binding = 3) writeonly buffer O  { float     data_o[];  };  // [D, n_head, n_q]
+
+const uint D       = 128u;
+const uint P       = 128u;
+const uint V_OFF_META = 4096u;
+const uint V_HEAD     = 4608u;
+
+uint chan4(uint u, uint j) { return (u >> (((j / 4u) * 8u) + ((j % 4u) * 2u))) & 3u; }
+
+void main() {
+    const uint qi = gl_WorkGroupID.x;
+    const uint h  = gl_WorkGroupID.y;
+    const uint t  = gl_LocalInvocationID.x;       // 0..7 -> channels [16t, 16t+16)
+
+    const uint vf_stride = p.vf_row_stride;       // = n_embd_kv
+    const uint vq_head = p.n_vp % P;              // ring head
+    const uint row = (h * p.n_q + qi) * p.n_kv;
+
+    float acc[16];
+    [[unroll]] for (uint j = 0u; j < 16u; ++j) acc[j] = 0.0;
+
+    for (uint key = 0u; key < p.n_kv; ++key) {
+        const float prob = data_s[row + key];
+        if (key < p.n_sink) {
+            [[unroll]] for (uint j = 0u; j < 16u; ++j)
+                acc[j] += prob * float(data_vf[h * D + t * 16u + j + key * vf_stride]);
+        } else if (key < p.n_sink + p.n_vp) {
+            const uint rel = key - p.n_sink;
+            const uint pg  = rel / P, tt = rel % P;
+            const uint hb  = h * V_HEAD;
+            vec2 sm = unpackHalf2x16(data_vp[(hb + V_OFF_META + tt * 4u) / 4u]);
+            const uint u = data_vp[(hb + tt * (D / 4u) + t * 4u) / 4u];
+            [[unroll]] for (uint j = 0u; j < 16u; ++j)
+                acc[j] += prob * (float(chan4(u, j)) * sm.x + sm.y);
+        } else {
+            const uint i    = key - (p.n_sink + p.n_vp);
+            const uint slot = (vq_head + i) % P;
+            [[unroll]] for (uint j = 0u; j < 16u; ++j)
+                acc[j] += prob * float(data_vf[h * D + t * 16u + j + (p.n_sink + slot) * vf_stride]);
+        }
+    }
+
+    [[unroll]] for (uint j = 0u; j < 16u; ++j)
+        data_o[(qi * p.n_head + h) * D + t * 16u + j] = acc[j];
+}
