+// loopcd M7c: packed Kitty-KV ops.
+
+struct ggml_tensor * ggml_kitty_qk(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k_f16,
+        struct ggml_tensor  * k_planes,
+        int32_t               n_sink,
+        int32_t               n_qbuf,
+        int32_t               n_pages,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(k_f16->type == GGML_TYPE_F16);
+    GGML_ASSERT(k_planes->type == GGML_TYPE_I8);
+    GGML_ASSERT(q->ne[0] == 128);   // head_dim is fixed by the packed layout
+
+    const int64_t n_kv = (int64_t) n_sink + (int64_t) n_pages * 128 + n_qbuf;
+    int64_t ne[4] = { n_kv, q->ne[2], q->ne[1], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    struct { int32_t n_sink, n_qbuf, n_pages; float scale; } params = { n_sink, n_qbuf, n_pages, scale };
+    ggml_set_op_params(result, &params, sizeof(params));
+
+    result->op     = GGML_OP_KITTY_QK;
+    result->src[0] = q;
+    result->src[1] = k_f16;
+    result->src[2] = k_planes;
+    return result;
+}
+
+struct ggml_tensor * ggml_kitty_sv(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * probs,
+        struct ggml_tensor  * v_f16,
+        struct ggml_tensor  * v_planes,
+        int32_t               n_sink,
+        int32_t               n_vp,
+        int32_t               n_vqbuf) {
+    GGML_ASSERT(probs->type == GGML_TYPE_F32);
+    GGML_ASSERT(v_f16->type == GGML_TYPE_F16);
+    GGML_ASSERT(v_planes->type == GGML_TYPE_I8);
+    GGML_ASSERT(probs->ne[0] == (int64_t) n_sink + n_vp + n_vqbuf);
+
+    int64_t ne[4] = { 128, probs->ne[2], probs->ne[1], 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    struct { int32_t n_sink, n_vp, n_vqbuf, pad; } params = { n_sink, n_vp, n_vqbuf, 0 };
+    ggml_set_op_params(result, &params, sizeof(params));
+
+    result->op     = GGML_OP_KITTY_SV;
+    result->src[0] = probs;
+    result->src[1] = v_f16;
+    result->src[2] = v_planes;
+    return result;
+}
