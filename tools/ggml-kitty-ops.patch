 }
 
+// loopcd M7c: packed Kitty-KV CPU reference. Thread 0 does all the work; the ops are
+// the test oracle, not a performance path.
+static inline int kitty_get_i32(const struct ggml_tensor * t, int i) {
+    int32_t v; memcpy(&v, (const char *) t->op_params + 4 * i, 4); return v;
+}
+static inline float kitty_get_f32(const struct ggml_tensor * t, int i) {
+    float v; memcpy(&v, (const char *) t->op_params + 4 * i, 4); return v;
+}
+static inline uint8_t kitty_byte(const uint8_t * p, size_t off) { return p[off]; }
+static inline ggml_fp16_t kitty_f16_at(const uint8_t * p, size_t off) {
+    ggml_fp16_t h; memcpy(&h, p + off, 2); return h;
+}
+
+void ggml_compute_forward_kitty_qk(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    using namespace kitty_fork_layout;
+    if (params->ith != 0) return;
+
+    const struct ggml_tensor * q  = dst->src[0];
+    const struct ggml_tensor * kf = dst->src[1];
+    const struct ggml_tensor * kp = dst->src[2];
+
+    const int32_t n_sink  = kitty_get_i32(dst, 0);
+    const int32_t n_qbuf  = kitty_get_i32(dst, 1);
+    const int32_t n_pages = kitty_get_i32(dst, 2);
+    const float   scale   = kitty_get_f32(dst, 3);
+
+    const int D_ = (int) q->ne[0], H = (int) q->ne[1], NQ = (int) q->ne[2];
+    const int n_kv = (int) dst->ne[0];
+
+    const float          * qp   = (const float          *) q->data;
+    const ggml_fp16_t    * kfp  = (const ggml_fp16_t    *) kf->data;
+    const uint8_t        * kpp  = (const uint8_t        *) kp->data;
+    float                * out  = (float                *) dst->data;
+
+    for (int h = 0; h < H; ++h) {
+        for (int qi = 0; qi < NQ; ++qi) {
+            const float * qh  = qp + (qi * H + h) * D_;
+            float *       row = out + (h * NQ + qi) * n_kv;
+
+            // Sink: staging rows are [0, n_sink) and key == absolute position.
+            for (int key = 0; key < n_sink; ++key) {
+                const ggml_fp16_t * krow = kfp + (size_t) key * H * D_ + (size_t) h * D_;
+                float acc = 0.0f;
+                for (int d = 0; d < D_; ++d) acc += qh[d] * ggml_fp16_to_fp32(krow[d]);
+                row[key] = acc * scale;
+            }
+            // Pending (qbuf): the key axis is [sink | pages | qbuf], so qbuf keys sit
+            // AFTER the packed pages, while the K pending staging rows are CONTIGUOUS at
+            // [n_sink, n_sink + n_qbuf). Map key -> row explicitly; using row == key
+            // silently zeroes the pending logits whenever n_pages > 0.
+            for (int i = 0; i < n_qbuf; ++i) {
+                const int key = n_sink + n_pages * P + i;
+                const ggml_fp16_t * krow = kfp + (size_t) (n_sink + i) * H * D_ + (size_t) h * D_;
+                float acc = 0.0f;
+                for (int d = 0; d < D_; ++d) acc += qh[d] * ggml_fp16_to_fp32(krow[d]);
+                row[key] = acc * scale;
+            }
+
+            for (int pg = 0; pg < n_pages; ++pg) {
+                const uint8_t * page = kpp + (size_t) pg * k_page_bytes(H);
+                for (int t = 0; t < P; ++t) {
+                    float acc = 0.0f;
+                    for (int d = 0; d < D_; ++d) {
+                        const uint8_t * head = page + (size_t) h * K_HEAD_BYTES;
+                        const int low = (head[d * (P / 4) + t / 4] >> ((t & 3) * 2)) & 3;
+                        const int idx = head[K_OFF_IDX + d];
+                        int code = low;
+                        if (idx < D_BOOST) {
+                            const int high = (head[K_OFF_HIGH + (size_t) idx * (P / 4) + t / 4]
+                                              >> ((t & 3) * 2)) & 3;
+                            code = low | (high << 2);
+                        }
+                        const float s = ggml_fp16_to_fp32(kitty_f16_at(head, K_OFF_META + d * 4));
+                        const float m = ggml_fp16_to_fp32(kitty_f16_at(head, K_OFF_META + d * 4 + 2));
+                        acc += qh[d] * ((float) code * s + m);
+                    }
+                    row[n_sink + pg * P + t] = acc * scale;
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_kitty_sv(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    using namespace kitty_fork_layout;
+    if (params->ith != 0) return;
+
+    const struct ggml_tensor * probs = dst->src[0];
+    const struct ggml_tensor * vf    = dst->src[1];
+    const struct ggml_tensor * vp    = dst->src[2];
+
+    const int32_t n_sink  = kitty_get_i32(dst, 0);
+    const int32_t n_vp    = kitty_get_i32(dst, 1);
+    const int32_t n_vqbuf = kitty_get_i32(dst, 2);
+
+    const int D_ = (int) dst->ne[0], H = (int) dst->ne[1], NQ = (int) dst->ne[2];
+    const int n_kv = (int) probs->ne[0];
+    const int vq_head = n_vp % P;
+
+    const float       * sp  = (const float       *) probs->data;
+    const ggml_fp16_t * vfp = (const ggml_fp16_t *) vf->data;
+    const uint8_t     * vpp = (const uint8_t     *) vp->data;
+    float             * out = (float             *) dst->data;
+
+    for (int h = 0; h < H; ++h) {
+        for (int qi = 0; qi < NQ; ++qi) {
+            const float * prow = sp + ((size_t) h * NQ + qi) * n_kv;
+            float * orow = out + ((size_t) qi * H + h) * D_;
+            for (int d = 0; d < D_; ++d) orow[d] = 0.0f;
+
+            for (int key = 0; key < n_kv; ++key) {
+                const float prob = prow[key];
+                if (key < n_sink) {
+                    const ggml_fp16_t * vrow = vfp + (size_t) key * H * D_ + (size_t) h * D_;
+                    for (int d = 0; d < D_; ++d) orow[d] += prob * ggml_fp16_to_fp32(vrow[d]);
+                } else if (key < n_sink + n_vp) {
+                    const int rel = key - n_sink;
+                    const int pg  = rel / P, tt = rel % P;
+                    const uint8_t * page = vpp + (size_t) pg * v_page_bytes(H);
+                    const uint8_t * head = page + (size_t) h * V_HEAD_BYTES;
+                    const float s = ggml_fp16_to_fp32(kitty_f16_at(head, V_OFF_META + tt * 4));
+                    const float m = ggml_fp16_to_fp32(kitty_f16_at(head, V_OFF_META + tt * 4 + 2));
+                    for (int d = 0; d < D_; ++d) {
+                        const int qq = (head[(size_t) tt * (D / 4) + d / 4] >> ((d & 3) * 2)) & 3;
+                        orow[d] += prob * ((float) qq * s + m);
+                    }
+                } else {
+                    const int i = key - (n_sink + n_vp);
+                    const int slot = (vq_head + i) % P;
+                    const ggml_fp16_t * vrow = vfp + (size_t) (n_sink + slot) * H * D_ + (size_t) h * D_;
+                    for (int d = 0; d < D_; ++d) orow[d] += prob * ggml_fp16_to_fp32(vrow[d]);
+                }
+            }
+        }
+    }
+}
+
 
