diff --git a/src/ggml-cpu/kitty-layout.h b/src/ggml-cpu/kitty-layout.h
new file mode 100644
index 00000000..a3cf5d81
--- /dev/null
+++ b/src/ggml-cpu/kitty-layout.h
@@ -0,0 +1,27 @@
+// src/ggml-cpu/kitty-layout.h — fixed part of the packed Kitty-KV layout (mirror of
+// loopcd/src/cache_layout.h). Fixed by the M7 design: P=128, D=128, D_BOOST=32.
+#pragma once
+#include <cstddef>
+
+namespace kitty_fork_layout {
+constexpr int P       = 128;
+constexpr int D       = 128;
+constexpr int D_BOOST = 32;
+
+constexpr size_t K_LOW_BYTES  = (size_t) D       * (P / 4);   // 4096
+constexpr size_t K_HIGH_BYTES = (size_t) D_BOOST * (P / 4);   // 1024
+constexpr size_t K_IDX_BYTES  = (size_t) D;                   // 128
+constexpr size_t K_META_BYTES = (size_t) D * 2 * 2;           // 512
+constexpr size_t K_HEAD_BYTES = K_LOW_BYTES + K_HIGH_BYTES + K_IDX_BYTES + K_META_BYTES; // 5760
+constexpr size_t K_OFF_HIGH   = K_LOW_BYTES;
+constexpr size_t K_OFF_IDX    = K_LOW_BYTES + K_HIGH_BYTES;
+constexpr size_t K_OFF_META   = K_OFF_IDX + K_IDX_BYTES;
+
+constexpr size_t V_DATA_BYTES = (size_t) D * (P / 4);         // 4096
+constexpr size_t V_META_BYTES = (size_t) P * 2 * 2;           // 512
+constexpr size_t V_HEAD_BYTES = V_DATA_BYTES + V_META_BYTES;  // 4608
+constexpr size_t V_OFF_META   = V_DATA_BYTES;
+
+inline size_t k_page_bytes(int H) { return (size_t) H * K_HEAD_BYTES; }
+inline size_t v_page_bytes(int H) { return (size_t) H * V_HEAD_BYTES; }
+} // namespace kitty_fork_layout
diff --git a/src/ggml-cpu/ops.cpp b/src/ggml-cpu/ops.cpp
